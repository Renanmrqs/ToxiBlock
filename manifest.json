
{
    "manifest_version": 3,
    "name": "ToxiBlock",
    "version": "1.0.0",
    "description": "Filtra comentários negativos usando Machine Learning (SentimentAI).",
    "content_scripts": [
        {
        "matches": ["https://www.youtube.com/*", "https://x.com/*", "https://www.twitter.com/*"],
        "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}